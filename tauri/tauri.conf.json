{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PiHub",
  "version": "1.2.0",
  "identifier": "com.pihub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/image-studio/assets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "pihub"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCQjk3NDMzRUMyRTY0MzcKUldRM1pDN3NNM1M1S3o2NFM0WjhoYjVjYkJsRXF1RXpnakZWSDNLN0Yvc0JRSWdBblV2R0llTWIK",
      "endpoints": [
        "https://github.com/lllll081926i/pihub/releases/latest/download/latest.json"
      ]
    }
  }
}
